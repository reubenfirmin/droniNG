QGroupBox {
    font-weight: bold;
}

/* Preserve the channel direction cue while using the dark palette. */
QSlider::sub-page:horizontal[state="normal"], QSlider::add-page:vertical {
    background: palette(Highlight);
}

QSlider::add-page:horizontal[state="inverted"] {
    background: #f67400;
}

Utils--StyledBar QComboBox QListView {
    background: palette(Base);
    color: palette(Text);
    selection-background-color: palette(Highlight);
    selection-color: palette(HighlightedText);
}

Utils--StyledBar QComboBox QListView::item {
    padding: 4px;
}
