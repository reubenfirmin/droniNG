   <item>
    <widget class="QScrollArea" name="autotuneScrollArea">
     <property name="widgetResizable"><bool>true</bool></property>
     <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
     <widget class="QWidget" name="autotuneContent">
      <layout class="QVBoxLayout" name="autotuneContentLayout">
       <property name="spacing"><number>20</number></property>
       <property name="leftMargin"><number>12</number></property>
       <property name="topMargin"><number>12</number></property>
       <property name="rightMargin"><number>12</number></property>
       <property name="bottomMargin"><number>12</number></property>
       <item>
        <widget class="QLabel" name="autotuneWarning">
         <property name="role" stdset="0"><string>notice</string></property>
         <property name="maximumSize"><size><width>1000</width><height>16777215</height></size></property>
         <property name="wordWrap"><bool>true</bool></property>
         <property name="text"><string>&lt;b&gt;Autotune moves the aircraft automatically&lt;/b&gt;&lt;br/&gt;Use a large, open flying area and keep control of the aircraft throughout the measurement. Review the resulting tune before flying with it.</string></property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="autotuneInstructions">
         <property name="maximumSize"><size><width>1000</width><height>16777215</height></size></property>
         <property name="wordWrap"><bool>true</bool></property>
         <property name="textInteractionFlags"><set>Qt::TextBrowserInteraction</set></property>
         <property name="openExternalLinks"><bool>true</bool></property>
         <property name="text"><string>&lt;h3&gt;Run an autotune&lt;/h3&gt;
&lt;ol&gt;
&lt;li&gt;Read these steps before flying. The &lt;a href="https://vimeo.com/104806460"&gt;original autotuning tutorial&lt;/a&gt; demonstrates the measurement flight.&lt;/li&gt;
&lt;li&gt;In &lt;b&gt;Input → Flight Mode Switch Settings&lt;/b&gt;, assign one switch position to &lt;b&gt;Autotune&lt;/b&gt; and keep another position available for normal flight.&lt;/li&gt;
&lt;li&gt;Enable the Autotune module below, click &lt;b&gt;Save&lt;/b&gt;, then power cycle the flight controller.&lt;/li&gt;
&lt;li&gt;Take off in a normal flight mode. Once stable, switch to Autotune. After a short delay, the aircraft will oscillate for approximately 60 seconds. Continue flying it with the sticks; your inputs do not spoil the measurement.&lt;/li&gt;
&lt;li&gt;When the oscillation stops, land and disarm so the controller saves the measurements.&lt;/li&gt;
&lt;li&gt;Reconnect to DroniNG and review the results in the guided tune dialog. Use &lt;b&gt;Adjust previous autotune&lt;/b&gt; to revisit an earlier result, or &lt;b&gt;From data file&lt;/b&gt; to load a recorded result.&lt;/li&gt;
&lt;li&gt;Select a normal flight mode before your next flight. The controller will not arm while Autotune is selected.&lt;/li&gt;
&lt;/ol&gt;</string></property>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="groupBox_5">
         <property name="title"><string>Autotune module</string></property>
         <layout class="QVBoxLayout" name="verticalLayout_4">
          <item>
           <widget class="QCheckBox" name="enableAutoTune">
            <property name="text"><string>Enable Autotune module</string></property>
            <property name="objrelation" stdset="0"><stringlist>
             <string>objname:ModuleSettings</string><string>fieldname:AdminState</string>
             <string>element:Autotune</string><string>checkedoption:Enabled</string><string>uncheckedoption:Disabled</string>
            </stringlist></property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="label_13">
            <property name="wordWrap"><bool>true</bool></property>
            <property name="text"><string>Save and power cycle the controller after enabling the module.</string></property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="horizontalLayout">
            <item><widget class="QPushButton" name="adjustTune"><property name="text"><string>Adjust previous autotune…</string></property></widget></item>
            <item><widget class="QPushButton" name="fromDataFileBtn"><property name="text"><string>From data file…</string></property></widget></item>
            <item><spacer name="actionSpace"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item><spacer name="pageSpace"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
      </layout>
     </widget>
    </widget>
